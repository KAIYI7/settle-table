# ==============================================================================
# SettleTable Reference Caddyfile (Tier 1 Ingress & TLS Termination)
# ==============================================================================
# Provides automatic HTTPS, wire protection, and loopback security boundaries.

{
    # Global options
    admin off
}

# Change to your public domain name (e.g., settletable.example.com)
{$SETTLETABLE_DOMAIN:localhost} {
    # Request body limit (allows up to 10 MB for receipt photo uploads)
    request_body {
        max_size 10MB
    }

    # Security: Block external access to the loopback-only bootstrap endpoint
    @blocked_bootstrap {
        path_regexp bootstrap ^/api/meals/[^/]+/bootstrap$
    }
    respond @blocked_bootstrap "Forbidden: Remote meal provisioning is prohibited" 403

    # Reverse proxy to the SettleTable WSGI application
    reverse_proxy settletable:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Health check configuration
        health_uri /healthz
        health_interval 30s
        health_timeout 5s
    }

    # Strict Transport Security (HSTS) and defense-in-depth security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
    }

    # Structured logging
    log {
        output stdout
        format console
    }
}

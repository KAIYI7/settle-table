# ==============================================================================
# SettleTable Production & Deployment Environment Configuration
# ==============================================================================
# Copy this file to .env and configure for your deployment environment.
# Never commit real credentials, secret tokens, or private URLs to version control.

# --- Database & Persistent Storage ---
# Path to the SQLite WAL database file.
# In containerized environments, point to a persistent volume (e.g., /data/settletable.sqlite).
SETTLETABLE_DB_PATH=/data/settletable.sqlite

# Directory where uploaded receipt photos are stored.
# Defaults to a 'receipt_photos' directory alongside SETTLETABLE_DB_PATH if unset.
SETTLETABLE_STORAGE_DIR=/data/receipt_photos

# --- Ingress, Host & Exact-Origin Security ---
# Canonical public application origin (scheme + domain + optional port, no trailing slash).
# Crucial for CSRF validation: mutating browser requests MUST match this origin exactly.
# For Cloudflare Named Tunnel deployments with a custom domain:
SETTLETABLE_SERVER_ORIGIN=https://settle.example.com

# Comma-separated list of allowed HTTP Host header values.
# Requests with unrecognized Host headers will be rejected with HTTP 400.
# Include the public hostname, loopback interfaces, and container service name:
SETTLETABLE_ALLOWED_HOSTS=settle.example.com,127.0.0.1:8000,localhost:8000,settletable:8000

# --- Cloudflare Named Tunnel Configuration (Optional Docker Profile) ---
# Tunnel token provided by the Cloudflare Zero Trust dashboard (Networks > Tunnels).
# Required when using: docker compose --profile with-cloudflared up -d
# Note: Cloudflare Access is NOT required and must not be enabled; diners use ordinary browsers.
# CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...your_cloudflare_tunnel_token_here...

# --- Server Binding (for standalone runner) ---
SETTLETABLE_HOST=0.0.0.0
SETTLETABLE_PORT=8000

# --- Session TTL & Expiry Configuration ---
# Session and organizer claim lifetime in seconds.
# Defaults to 604800 (7 days). Allowed range: 1 to 2592000 (30 days).
SETTLETABLE_SESSION_TTL=604800

# --- Optional Notion Export Configuration ---
# Optional server-level Notion API integration token.
# Organizers can also provide their token per-export in the browser UI.
# SETTLETABLE_NOTION_TOKEN=ntn_your_notion_secret_token_here

# Permit synchronous Notion export (useful for specific automated test suites).
# Default is 0 (asynchronous execution in background thread with 60s timeout).
SETTLETABLE_ALLOW_SYNC_EXPORT=0

# --- Testing & Demonstration Mocks (DO NOT ENABLE IN PRODUCTION) ---
# Set to 1 only to simulate OCR or Notion export without native ML wheels or external API calls.
SETTLETABLE_MOCK_OCR=0
SETTLETABLE_MOCK_NOTION=0
